/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/logo.svg
  Cache-Control: public, max-age=2592000

# Aktualizacje NetUnstick
/NetUnstick/updates/latest.json
  Cache-Control: no-cache, max-age=0, must-revalidate
  Content-Type: application/json; charset=utf-8

/NetUnstick/updates/*.pkg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

/NetUnstick/updates/*.sha256
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/plain; charset=utf-8
